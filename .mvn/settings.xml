<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <mirrors>
        <mirror>
            <id>mhbas-aliyun-central</id>
            <name>Aliyun Maven Central Mirror</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <mirrorOf>central</mirrorOf>
        </mirror>
        <mirror>
            <id>mhbas-jvnet-mirror</id>
            <name>Mirror of retired Java.net repositories</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <mirrorOf>jvnet-nexus-releases,jvnet-nexus-staging,jvnet-nexus-snapshots,jvnet-nexus-promoted</mirrorOf>
        </mirror>
    </mirrors>
</settings>
